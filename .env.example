# ─── Site ─────────────────────────────────────────────────────────────
# URL publique (liens absolus, Open Graph, lien du résultat dans l'email)
NEXT_PUBLIC_SITE_URL=https://quiz.atexitalia.it
# Page de l'informativa privacy (case obligatoire du formulaire)
NEXT_PUBLIC_PRIVACY_URL=https://www.atexitalia.it/privacy
# "true" pour autoriser l'indexation ; toute autre valeur = noindex
NEXT_PUBLIC_INDEXABLE=false
# Destinataire du CTA « Parla con un esperto » (serveur uniquement)
CONTACT_EMAIL=info@atexitalia.it

# ─── Cloudflare Turnstile ─────────────────────────────────────────────
# Clés de test Cloudflare (toujours valides) pour le développement :
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Supabase (projet du CRM Nexo) ────────────────────────────────────
# Settings → API. La clé service_role ne doit JAMAIS avoir le préfixe
# NEXT_PUBLIC : elle n'est lue que par le serveur (route /api/lead).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
